{
  "name": "Fedora KDE VPS",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "codespace",
  "mounts": [],
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "noVNC desktop", "onAutoForward": "openBrowser" },
    "5901": { "label": "VNC", "onAutoForward": "silent" }
  },
  "onCreateCommand": "chmod +x /workspaces/github-vps/.devcontainer/setup.sh",
  "postStartCommand": "setsid nohup bash /workspaces/github-vps/.devcontainer/setup.sh > /tmp/setup.log 2>&1 &"
}
